# Dépendances
node_modules/
.pnp
.pnp.js

# La racine n'est pas un projet Node : le seul package.json est dans api/.
# Un npm install lancé par mégarde ici produit un lock vide de sens, qui
# laisserait croire le contraire. Le lock d'api/ est versionné, lui.
/package-lock.json
/package.json

# Build
dist/
build/
*.tsbuildinfo

# Interface allégée — artefact régénérable par scripts/construire-web.py.
# La SOURCE est web/ ; web-servi/ n'en est que la version sans commentaires.
# Le versionner ferait apparaître les deux dans chaque diff touchant
# l'interface, et rien ne garantirait qu'ils restent cohérents.
web-servi/

# Variables d'environnement — ne jamais versionner de secret
.env
.env.*
!.env.example

# Journaux
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# Tests
coverage/
.nyc_output/

# Éditeurs
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# Système
.DS_Store
Thumbs.db

# Base de données — sauvegardes et exports locaux
*.dump
*.sql.gz
db/sauvegardes/

# Temporaire
tmp/
.cache/

# Captures d'écran de vérification — artefacts locaux, régénérables
# par Chromium headless. Elles servent à contrôler le rendu, pas à le décrire.
.captures/
